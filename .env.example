# Required: your Anthropic API key (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=

# Optional overrides
AEL_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max   (higher = more thorough, slower, more tokens)
AEL_EFFORT=high
# Re-run a declined request on a fallback model automatically (1 = on)
AEL_USE_FALLBACKS=1
# Where cases (originals, derived images, reports) are stored
AEL_DATA_DIR=./data
# Largest upload accepted, in MB
AEL_MAX_UPLOAD_MB=4096
